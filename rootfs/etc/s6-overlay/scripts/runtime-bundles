#!/command/with-contenv sh
set -eu

contents=/etc/s6-overlay/s6-rc.d/user/contents.d

if [ -n "${UPLOADSCRIPT:-}" ]; then
  if [ ! -f "$UPLOADSCRIPT" ]; then
    echo >&2 "ERROR: UPLOADSCRIPT program/script is not defined or does not exist"
    exit 1
  fi
  touch "${contents}/pure-uploadscript"
else
  rm -f "${contents}/pure-uploadscript"
fi
